{
 "@context": {
  "@version": 1.1,
  "@base": "https://chpollin.github.io/klawiter-rescue/print/",
  "kp": "https://chpollin.github.io/klawiter-rescue/vocab/print/",
  "prov": "http://www.w3.org/ns/prov#",
  "oa": "http://www.w3.org/ns/oa#",
  "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
  "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
  "xsd": "http://www.w3.org/2001/XMLSchema#",
  "id": "@id",
  "type": "@type",
  "graph": "@graph",
  "label": "rdfs:label",
  "value": "rdf:value",
  "field": "kp:field",
  "producer": "kp:producer",
  "rule": {"@id": "kp:rule", "@type": "@id"},
  "state": "kp:state",
  "source": {"@id": "oa:hasSource", "@type": "@id"},
  "selector": {"@id": "oa:hasSelector"},
  "start": {"@id": "oa:start", "@type": "xsd:integer"},
  "end": {"@id": "oa:end", "@type": "xsd:integer"},
  "exact": "oa:exact",
  "derivedFrom": {"@id": "prov:wasDerivedFrom", "@type": "@id"},
  "model": "kp:model",
  "fileName": "kp:fileName",
  "sha256Prefix": "kp:sha256Prefix",
  "title_of_volume": "kp:volumeTitle",
  "text": "kp:text",
  "sha256": "kp:sha256",
  "volume": "kp:volume",
  "part": "kp:part",
  "kind": "kp:kind",
  "address": "kp:address",
  "pdfPage": {"@id": "kp:pdfPage", "@type": "xsd:integer"},
  "pdfPageEnd": {"@id": "kp:pdfPageEnd", "@type": "xsd:integer"},
  "line": {"@id": "kp:line", "@type": "xsd:integer"},
  "column": {"@id": "kp:column", "@type": "xsd:integer"},
  "term": "kp:indexTerm",
  "passage": "kp:passage",
  "context": {"@id": "kp:headingContext", "@container": "@list"},
  "entry": {"@id": "kp:entry", "@type": "@id"},
  "objectText": "kp:objectText",
  "types": {"@id": "kp:objectType", "@container": "@list"},
  "title": "kp:title",
  "subtitle": "kp:subtitle",
  "original_title": "kp:originalTitle",
  "variant_titles": {"@id": "kp:variantTitle", "@container": "@list"},
  "subject": "kp:subject",
  "language": "kp:language",
  "work_refs": {"@id": "kp:workReference", "@container": "@list"},
  "persons": {"@id": "kp:person", "@container": "@list"},
  "name": "kp:name",
  "roles": {"@id": "kp:role", "@container": "@list"},
  "imprints": {"@id": "kp:imprint", "@container": "@list"},
  "place": "kp:place",
  "publisher": "kp:publisher",
  "year": "kp:year",
  "year_end": "kp:yearEnd",
  "year_bracketed": "kp:yearBracketed",
  "circa": "kp:circa",
  "extent": "kp:extent",
  "raw": "kp:raw",
  "parts": {"@id": "kp:extentPart", "@container": "@list"},
  "volumes": "kp:volumes",
  "illustrations": "kp:illustrations",
  "edition_notes": {"@id": "kp:editionNote", "@container": "@list"},
  "note_text": "kp:noteText",
  "years": {"@id": "kp:years", "@container": "@list"},
  "series": {"@id": "kp:series", "@container": "@list"},
  "number": "kp:number",
  "periodicals": {"@id": "kp:periodical", "@container": "@list"},
  "siglum": "kp:siglum",
  "issue": "kp:issue",
  "date": "kp:date",
  "pages": "kp:pages",
  "hosts": {"@id": "kp:host", "@container": "@list"},
  "reviewed": {"@id": "kp:reviewed", "@container": "@list"},
  "locator": "kp:locator",
  "event": "kp:event",
  "medium": "kp:medium",
  "contents": {"@id": "kp:contentItem", "@container": "@list"},
  "informants": {"@id": "kp:informant", "@container": "@list"},
  "holdings": {"@id": "kp:holding", "@container": "@list"},
  "repository": "kp:repository",
  "notes": {"@id": "kp:note", "@container": "@list"},
  "references": {"@id": "kp:reference", "@container": "@list"},
  "targets": {"@id": "kp:target", "@container": "@list"},
  "normalized": "kp:normalizedAddress",
  "record": {"@id": "kp:targetRecord", "@type": "@id"},
  "relation": "kp:relation",
  "target": {"@id": "kp:relationTarget", "@type": "@id"},
  "inherited": "kp:inherited",
  "llm_model": "kp:llmModel",
  "reviewState": "kp:reviewState",
  "review": {"@id": "kp:review", "@type": "@id"},
  "reviews": {"@id": "kp:reviewDecision", "@type": "@id", "@container": "@set"},
  "decision": "kp:decision",
  "about": {"@id": "kp:about", "@type": "@id"},
  "targetField": "kp:targetField",
  "reviewNote": "kp:reviewNote",
  "correction": "kp:correction",
  "wasAssociatedWith": {"@id": "prov:wasAssociatedWith", "@type": "@id"},
  "endedAtTime": {"@id": "prov:endedAtTime", "@type": "xsd:dateTime"}
 }
}
