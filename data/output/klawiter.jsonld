        2019
      ],
      "timePeriod": "contemporary",
      "publisher": {
        "@id": "klawiter:publisher/office%3A%20Karin%20Gr%C3%A4ber",
        "@type": "schema:Organization",
        "name": "office: Karin Gräber"
      },
      "locationCreated": {
        "@id": "klawiter:place/Krems%20an%20der%20Donau",
        "@type": "schema:Place",
        "name": "Krems an der Donau"
      },
      "allLocations": [
        "Krems an der Donau",
        "Wien",
        "München",
        "Salzburg"
      ],
      "inLanguage": "de",
      "languageName": "German",
      "numberOfPages": 150,
