      "mainCategory": "Secondary Literature",
      "bibliographicCitation": "\"Stefan Zweig: Biographer and Teacher\" in The Sewanee Review [Sewanee, TN], 48:2 [April-June 1940], pp. (245)-254. An excerpt is printed in Twentieth-Century Literary Criticism [1985], Vol. 17, pp. 426-427. This excerpt is included in the article \"Stefan Zweig 1881-1942\", pp. 420-460",
      "sourceBlobId": 2
    },
    {
      "@type": [
        "schema:ScholarlyArticle",
        "klawiter:SecondaryLiteratureEntry"
      ],
      "@id": "klawiter:entry/3122",
      "entryType": "secondary-literature",
      "sourcePageId": 3122,
      "pageNamespace": 0,
      "name": {
        "@value": "Rehder, Elke",
        "@language": "de"
      },
      "originalTitle": "1",
      "sourceTextId": 35056,
      "datePublished": "2014",
      "allYears": [
        1940,
        1942,
        1943,
        1944,
        1996,
        2002,
        2003,
