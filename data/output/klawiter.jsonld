      "entryType": "secondary-literature",
      "sourcePageId": 2710,
      "pageNamespace": 0,
      "name": {
        "@value": "Ziegler, Edda",
        "@language": "de"
      },
      "originalTitle": "[Die großen Erzählungen",
      "sourceTextId": 59881,
      "datePublished": "2013",
      "timePeriod": "contemporary",
      "publisher": {
        "@id": "klawiter:publisher/Deutscher%20Taschenbuch%20Verlag",
        "@type": "schema:Organization",
        "name": "Deutscher Taschenbuch Verlag"
      },
      "locationCreated": {
        "@id": "klawiter:place/M%C3%BCnchen",
        "@type": "schema:Place",
        "name": "München",
        "sameAs": "http://www.wikidata.org/entity/Q1726"
      },
      "inLanguage": "de",
      "languageName": "German",
      "numberOfPages": 318,
      "categories": [
        "Secondary Literature / Authors (German)"
      ],
      "mainCategory": "Secondary Literature",
      "relation": [
        {
          "@id": "klawiter:entry/2535"
        }
      ],
      "bibliographicCitation": "[2013]: Deutscher Taschenbuch Verlag, München\n\nStefan Zweig. Die großen Erzählungen. Edited with an afterword by Edda Ziegler. 318/(1)p. [dtv 14236]. See: Die großen Erzählungen, \"Nachwort\", No. 6, pp. 301-(319)\n\nContents of the Nachwort:\n\nIntroductory discussion of Zweig, pp. 301-306\nBrennendes Geheimnis, pp. 306-308\nAngst, pp. 308-310\nDer Amokläufer, pp. 310-313\nDie unsichtbare Sammlung, pp. 313-316\nSchachnovelle, pp. 317-(319)",
      "sourceBlobId": 6
