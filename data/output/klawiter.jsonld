        "@id": "klawiter:publisher/written%20on%20the%20margin%20of%20a%20letter%20to%20Zweig%20from%20the%20Insel-Verlag",
        "@type": "schema:Organization",
        "name": "written on the margin of a letter to Zweig from the Insel-Verlag"
      },
      "locationCreated": {
        "@id": "klawiter:place/Berlin",
        "@type": "schema:Place",
