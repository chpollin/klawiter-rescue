      "name": {
        "@value": "\"Jupiter\" [Contains one illustration by John Pike] in Collier's [Springfield, OH], 112:1 [3 July 1943], pp. 30, 66-68",
        "@language": "en"
      },
      "sourceTextId": 12589,
      "author": {
        "@id": "http://www.wikidata.org/entity/Q78491",
        "@type": "schema:Person",
        "name": "Stefan Zweig"
      },
