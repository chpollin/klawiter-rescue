      "name": {
        "@value": "Stefan Zweig. Die geistige Einheit der Welt",
        "@language": "de"
      },
      "originalTitle": "I",
      "sourceTextId": 51619,
      "datePublished": "2017",
      "allYears": [
        1915,
        1916,
