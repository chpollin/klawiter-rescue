        "@id": "http://www.wikidata.org/entity/Q78491",
        "@type": "schema:Person",
        "name": "Stefan Zweig"
      },
      "datePublished": "1929",
      "timePeriod": "lifetime",
      "locationCreated": {
        "@id": "klawiter:place/Wien",
        "@type": "schema:Place",
        "name": "Wien",
        "sameAs": "http://www.wikidata.org/entity/Q1741"
