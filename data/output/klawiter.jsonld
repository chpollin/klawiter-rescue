      "name": {
        "@value": "Romain Rolland - Stefan Zweig. Von Welt zu Welt. Briefe einer Freundschaft 1914-1918",
        "@language": "de"
      },
      "sourceTextId": 18844,
      "author": {
        "@id": "http://www.wikidata.org/entity/Q78491",
        "@type": "schema:Person",
        "name": "Stefan Zweig"
      },
      "datePublished": "2014",
      "allYears": [
        1910,
        1911,
        1912,
        1913,
        1914,
        1915,
        1916,
        1917,
        1918,
