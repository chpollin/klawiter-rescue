      "name": {
        "@value": "\"Was wir wollen!\" Gedichte und Nachdichtungen",
        "@language": "de"
      },
      "originalTitle": "Poems by Stefan Zweig",
      "sourceTextId": 60133,
      "author": {
        "@id": "http://www.wikidata.org/entity/Q78491",
        "@type": "schema:Person",
        "name": "Stefan Zweig"
      },
      "datePublished": "2019",
      "allYears": [
        1802,
        1806,
        1821,
        1822,
        1823,
        1837,
        1838,
        1844,
        1854,
        1855,
        1858,
        1861,
        1865,
        1867,
        1885,
        1891,
        1893,
        1896,
        1901,
        1904,
        1912,
        1916,
        1922,
        1934,
        1945,
        1963,
