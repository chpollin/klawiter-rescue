      "@id": "klawiter:entry/2932",
      "entryType": "correspondence",
      "sourcePageId": 2932,
      "pageNamespace": 0,
      "name": {
        "@value": "Romain Rolland - Stefan Zweig. Briefwechsel 1910-1940",
        "@language": "de"
      },
      "sourceTextId": 18798,
      "author": {
        "@id": "http://www.wikidata.org/entity/Q78491",
        "@type": "schema:Person",
