      "name": {
        "@value": "Al-Wuḥaydī, Suʿād / Wheidi, Souad",
        "@language": "ar"
      },
      "sourceTextId": 32911,
      "datePublished": "2015",
      "timePeriod": "contemporary",
      "publisher": {
