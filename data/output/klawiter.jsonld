        1995
      ],
      "timePeriod": "late-20c",
      "locationCreated": {
        "@id": "klawiter:place/Frankfurt%20am%20Main",
        "@type": "schema:Place",
        "name": "Frankfurt am Main",
        "sameAs": "http://www.wikidata.org/entity/Q1794"
      },
      "allLocations": [
