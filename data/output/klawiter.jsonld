      "pageNamespace": 0,
      "name": {
        "@value": "Bức thư của người đàn bà không quen. Truyện tập truyện ngắn, truyện vừa chọn lọc",
        "@language": "vi"
      },
      "sourceTextId": 60276,
      "author": {
