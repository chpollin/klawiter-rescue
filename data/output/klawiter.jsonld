        "name": "Stefan Zweig"
      },
      "datePublished": "2010",
      "allYears": [
        1913,
        1939,
        2010
      ],
      "timePeriod": "contemporary",
      "locationCreated": {
        "@id": "klawiter:place/M%C3%BCnchen",
