      "pageNamespace": 0,
      "name": "Stefan Zweig, Leben und Werk",
      "originalTitle": "30 November 1994-3 February 1995",
      "sourceTextId": 28596,
      "datePublished": "1994",
      "allYears": [
        1881,
        1902,
        1936,
