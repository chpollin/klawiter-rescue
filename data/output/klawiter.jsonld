      "name": {
        "@value": "\"Stīfān Zfāygh.. taʿriyat al-nafs al-bashariyyah ʿalā ruqʿat shaṭranj\" [Stefan Zweig... the Uncovering of the Human Psyche on a Chessboard] in ultraṣawt [s.l.], 04 August 2017",
        "@language": "ar"
      },
      "sourceTextId": 32891,
      "datePublished": "2017",
