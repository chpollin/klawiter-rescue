# Normalize all text to LF so read_bytes()-based provenance hashes
# (segment_editions._code_hash, gate manifests) are platform-independent.
* text=auto eol=lf
data/raw/** binary

# The wiki's account tables (users, password hashes, watchlists) stay out of
# release archives; the pipeline reads only zweig_part_01.sql and the text stores.
data/raw/zweig_part_03.sql export-ignore
