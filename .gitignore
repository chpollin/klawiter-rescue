# Regenerable intermediate CSVs (re-run pipeline to recreate).
# Hand-labeled files are NOT regenerable and must live committed in tests/
# — the original test_sample_20.json was lost to this ignore rule.
data/intermediate/

# Individual entry files (6.296 files, regenerable)
data/output/entries/

# Regenerable No-Op overlay report (empty corrections store, byte-identical re-run)
data/output/corrections-report.json

# Bulk regenerable Gate-2 review material (internal sighting data, ~26 MB).
# The Gate-2 manifest commits their SHA-256 and counts; the CI reproduce job
# regenerates and verifies them. Never committed to the public repository.
data/output/reconciliation/candidates.json
data/output/reconciliation/review-queue.json

# Environment / secrets
.env
pipeline/.env

# Python cache
__pycache__/
*.pyc
.venv/

# Obsidian (user-specific workspace state)
knowledge/.obsidian/
.claude/settings.local.json
